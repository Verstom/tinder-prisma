//  Variables de entorno necesarias (tinder/.env):
//    USERS_DATABASE_URL          = postgresql://user:pass@host:5432/users_db
//    INTERACTIONS_DATABASE_URL   = postgresql://user:pass@host:5432/interactions_db
//    MATCHES_DATABASE_URL        = postgresql://user:pass@host:5432/matches_db
//    MESSAGES_DATABASE_URL       = postgresql://user:pass@host:5432/messages_db
//    SUBSCRIPTIONS_DATABASE_URL  = postgresql://user:pass@host:5432/subscriptions_db
//
//  Comandos de migración (ejecutar desde la raíz del proyecto):
//    npx prisma migrate dev --config users.config.ts --name init
//    npx prisma migrate dev --config interactions.config.ts --name init
//    npx prisma migrate dev --config matches.config.ts --name init
//    npx prisma migrate dev --config messages.config.ts --name init
//    npx prisma migrate dev --config subscriptions.config.ts --name init
//
//  Generar clientes Prisma:
//    npx prisma generate --config users.config.ts
//    npx prisma generate --config interactions.config.ts
//    npx prisma generate --config matches.config.ts
//    npx prisma generate --config messages.config.ts
//    npx prisma generate --config subscriptions.config.ts
