generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/subscriptions"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// SUBSCRIPTIONS SERVICE SCHEMA
// Base de datos: subscriptions_db  |  Puerto: 3005
// Gestiona planes de suscripción de usuarios: FREE, GOLD, PREMIUM.
// userId referencia la BD users_db (sin FK por ser microservicios).
// ===================================================================

enum SubscriptionPlan {
  FREE
  PREMIUM
  GOLD
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}
